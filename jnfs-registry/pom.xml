<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.jnfs</groupId>
        <artifactId>jnfs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jnfs-registry</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.jnfs</groupId>
            <artifactId>jnfs-common</artifactId>
        </dependency>
        <!-- 前端 SPA 产物：jar 内含 classpath:/static/** 资源，经 maven-shade-plugin 合并进 fat-jar 顶部 static/。
             运行期由 DashboardServer 的 StaticFileHandler 从 classpath 读取，不加载前端依赖 jar 的类。 -->
        <dependency>
            <groupId>org.jnfs</groupId>
            <artifactId>jnfs-dashboard-ui</artifactId>
        </dependency>
        <!-- Dashboard 登录鉴权：mysql 存储模式所需（版本由父 pom dependencyManagement 管理）。
             hutool（含 cn.hutool.crypto.digest.BCrypt）经 jnfs-common 传递引入，无需在此声明。 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.jnfs.registry.RegistryServer</mainClass>
                                </transformer>
                                <!-- 合并各依赖的 META-INF/services（MySQL + H2 驱动自动注册都需保留），
                                     否则 DriverManager 只认其中一个，h2/mysql 模式 java -jar 会 "No suitable driver" -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
